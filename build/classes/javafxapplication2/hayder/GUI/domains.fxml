<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<HBox spacing="20" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="javafxapplication2.hayderController.DomainsController">

    <stylesheets>
        <URL value="@domains.css" />
    </stylesheets>

    <!-- LEFT SIDE (Domains List UI) -->
    <VBox spacing="10" alignment="TOP_LEFT">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20" />
        </padding>

        <children>
            <Label text="All Domains" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

            <HBox spacing="10" alignment="CENTER_LEFT">
                <children>
                    <TextField fx:id="searchField" promptText="Search domains..." prefWidth="300" />
                    <Button fx:id="BackBtn" text=" ->Back To Home" onAction="#Back" styleClass="Back-button" />
                </children>
            </HBox>

            <ScrollPane fitToWidth="true" prefHeight="600">
                <content>
                    <FlowPane fx:id="domainsFlow" hgap="15" vgap="15" prefWrapLength="1000" />
                </content>
            </ScrollPane>
        </children>
    </VBox>

    <!-- RIGHT SIDE (Add Form) -->
    <VBox fx:id="addFormPane" spacing="10" alignment="TOP_LEFT" prefWidth="300"
          style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #ddd; -fx-border-radius: 8;">

        <Label text="Add Domain" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <Label text="Name:" />
        <TextField fx:id="nameField" promptText="Domain name" />

        <Label text="Description:" />
        <TextArea fx:id="descField" promptText="Domain description" prefHeight="120"/>

        <HBox spacing="10">
            <Button text="Save" onAction="#addDomain" styleClass="form-button" />
            <Button text="Cancel" onAction="#hideAddForm" styleClass="cancel-button" />
        </HBox>
    </VBox>

</HBox>
