<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/20.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="javafxapplication2.hayderController.ContractController"
      stylesheets="@contract.css"
      spacing="20"
      alignment="CENTER"
      prefWidth="700"
      prefHeight="700"
      styleClass="contract-root">

    <Label text="Gestion des Contrats" styleClass="contract-title"/>

    <VBox spacing="15" styleClass="contract-card">

        <!-- FORMULAIRE -->
        <VBox spacing="5">
            <Label text="Nom du Client :" />
            <TextField fx:id="clientNameField" promptText="Nom du client" styleClass="contract-input"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Type de Contrat :" />
            <ComboBox fx:id="contractTypeBox" styleClass="contract-input"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Date de Début :" />
            <DatePicker fx:id="startDatePicker" styleClass="contract-input"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Date de Fin :" />
            <DatePicker fx:id="endDatePicker" styleClass="contract-input"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Salaire :" />
            <TextField fx:id="salaryField" promptText="Montant du salaire" styleClass="contract-input"/>
        </VBox>

        <HBox spacing="20" alignment="CENTER">
            <Button text="Valider" fx:id="validateButton" styleClass="validate-btn" onAction="#validerContract"/>
            <Button text="Annuler" fx:id="cancelButton" styleClass="cancel-btn" onAction="#cancelContract"/>
            <Button text="Back" fx:id="BackButton" styleClass="validate-btn" onAction="#BackToDashboard"/>
        </HBox>

    </VBox>

    <!-- TABLE DES CONTRATS -->
    <TableView fx:id="contractTable" prefHeight="250" prefWidth="650">
        <columns>
            <TableColumn fx:id="nameColumn" text="Nom du Client" prefWidth="150"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="120"/>
            <TableColumn fx:id="startColumn" text="Date Début" prefWidth="120"/>
            <TableColumn fx:id="endColumn" text="Date Fin" prefWidth="120"/>
            <TableColumn fx:id="salaryColumn" text="Salaire" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>

