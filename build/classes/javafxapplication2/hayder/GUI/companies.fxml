<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="javafxapplication2.hayderController.companiesController">

    <stylesheets>
        <URL value="@companies.css" />
    </stylesheets>

    <!-- TOP BAR -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <TextField fx:id="searchField" promptText="Search companies..." prefWidth="300"/>
                <Button fx:id="BackBtn" text="← Back to Home" styleClass="Back-button"/>
                <Button fx:id="allDomainsBtn" text="All Domains"
                        style="-fx-background-color: #ff9800; -fx-text-fill: white;"/>
            </children>
        </HBox>
    </top>

    <!-- MAIN BODY -->
    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- LEFT PANEL: COMPANIES GRID -->
            <ScrollPane fitToWidth="true" prefHeight="600" prefWidth="650">
                <content>
                    <FlowPane fx:id="companiesFlow" hgap="15" vgap="15" prefWrapLength="600"/>
                </content>
            </ScrollPane>

            <!-- RIGHT PANEL: ADD FORM -->
            <VBox spacing="15" prefWidth="300" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10;">
                <children>
                    <Label text="Add New Company" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label text="Company Name:"/>
                    <TextField fx:id="companyNameField" promptText="Enter company name"/>
                    <Button fx:id="addBtn" text="Add Company" styleClass="add-button" prefWidth="200"/>
                </children>
            </VBox>

        </HBox>
    </center>

</BorderPane>
