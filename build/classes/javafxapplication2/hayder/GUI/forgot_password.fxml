<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480" prefWidth="520"
    style="-fx-background-color: linear-gradient(to bottom right, #eef3ff, #dce6f8);"
    stylesheets="@forgot_password.css"
    xmlns="http://javafx.com/javafx/24.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="javafxapplication2.hayderController.ForgotPasswordController">

    <children>
        <VBox alignment="CENTER" spacing="25" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 20 0 0 0;"
                   text="Mot de passe oublié"/>

            <VBox alignment="CENTER" spacing="18" styleClass="card">
                <padding><Insets bottom="30" left="40" right="40" top="30"/></padding>

                <ImageView fx:id="logoImage" fitHeight="120" fitWidth="120" pickOnBounds="true" preserveRatio="true"
                           style="-fx-background-radius: 60; -fx-border-radius: 60; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10,0,0,2);">
                    <image><Image url="@assetes/logo.png"/></image>
                </ImageView>

                <Label style="-fx-text-fill: #546e7a; -fx-font-size: 14; -fx-wrap-text: true; -fx-text-alignment: center;"
                       text="Entrez votre adresse email pour réinitialiser le mot de passe"/>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <ImageView fitHeight="20" fitWidth="20"><image><Image url="@assetes/email.png"/></image></ImageView>
                    <TextField fx:id="emailField" promptText="Adresse Email" styleClass="input-field" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Button fx:id="sendButton" styleClass="primary-btn" onAction="#onSendClick">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20"><image><Image url="@assetes/send.png"/></image></ImageView>
                    </graphic>
                    <text>Envoyer le lien</text>
                </Button>

                <HBox alignment="CENTER" spacing="5">
                    <ImageView fitHeight="16" fitWidth="16"><image><Image url="@assetes/login.png"/></image></ImageView>
                    <Hyperlink styleClass="link" text="Retour à la connexion" onAction="#onBackToLoginClick"/>
                </HBox>

            </VBox>
        </VBox>
    </children>
</AnchorPane>
