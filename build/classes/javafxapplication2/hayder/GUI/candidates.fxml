<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="javafxapplication2.hayderController.CandidatesController">

    <stylesheets>
        <URL value="@candidates.css" />
    </stylesheets>

    <!-- TOP BAR -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <TextField fx:id="searchField" promptText="Search candidates..." prefWidth="300"/>
                <Button fx:id="BackBtn" text="← Back to Home" styleClass="Back-home"/>
            </children>
        </HBox>
    </top>

    <!-- MAIN BODY -->
    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- LEFT PANEL: CANDIDATES GRID -->
            <ScrollPane fitToWidth="true" prefHeight="600" prefWidth="650">
                <content>
                    <FlowPane fx:id="candidatesFlow" hgap="15" vgap="15" prefWrapLength="600"/>
                </content>
            </ScrollPane>

            <!-- RIGHT PANEL: ADD CANDIDATE FORM -->
            <VBox spacing="15" prefWidth="300" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10;">
                <children>
                    <Label text="Add New Candidate" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label text="First Name:"/>
                    <TextField fx:id="firstNameField" promptText="Enter first name"/>

                    <Label text="Last Name:"/>
                    <TextField fx:id="lastNameField" promptText="Enter last name"/>

                    <Label text="Email:"/>
                    <TextField fx:id="emailField" promptText="Enter email"/>

                    <Label text="Phone:"/>
                    <TextField fx:id="phoneField" promptText="Enter phone"/>

                    <Button fx:id="addBtn" text="Add Candidate" styleClass="add-button" prefWidth="200"/>
                </children>
            </VBox>

        </HBox>
    </center>

</BorderPane>
