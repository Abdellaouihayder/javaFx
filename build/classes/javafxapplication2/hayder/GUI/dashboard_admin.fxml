<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="750" prefWidth="1200" stylesheets="@dashboard.css"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="javafxapplication2.hayderController.DashboardAdminController">

    <!-- TOP NAV BAR -->
    <top>
        <HBox spacing="15" styleClass="nav-bar">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20" />
            </padding>

            <HBox alignment="CENTER_RIGHT" spacing="25" HBox.hgrow="ALWAYS">
                <Label styleClass="nav-title" text="Job Portal Admin" />

                <Region HBox.hgrow="ALWAYS"/>

                <Button styleClass="nav-btn" text="Dashboard" onAction="#onDashboard">
                    <graphic>
                        <SVGPath styleClass="icon"
                                 content="M3 13h4v-4H3v4zm6 6h4v-10h-4v10zm6-6h4v-4h-4v4z" />
                    </graphic>
                </Button>

                <Button styleClass="nav-btn" text="Notifications" onAction="#onNotifications">
                    <graphic>
                        <SVGPath styleClass="icon"
                                 content="M12 2C10.3 2 9 3.3 9 5V6C6 6 4 8 4 11V16L2 18V19H22V18L20 16V11C20 8 18 6 15 6V5C15 3.3 13.7 2 12 2Z" />
                    </graphic>
                </Button>

                <Button styleClass="nav-btn" text="Profile" onAction="#onProfile">
                    <graphic>
                        <SVGPath styleClass="icon"
                                 content="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" />
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="25" styleClass="sidebar">
            <padding>
                <Insets top="40" right="20" bottom="20" left="20" />
            </padding>

            <Label styleClass="sidebar-section-title" text="Welcome Admin" />

            <VBox spacing="10">

                <Button styleClass="sidebar-btn-active" text="Home" onAction="#onHome">
                    <graphic>
                        <SVGPath styleClass="icon"
                                 content="M10 20V14H14V20H19V12H22L12 3 2 12H5V20H10Z" />
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" text="Manage Recruiter" onAction="#onManageRecruiter">
                    <graphic>
                        <SVGPath styleClass="icon"
                                 content="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" />
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" text="Manage Companies" onAction="#onManageCompanies">
                    <graphic>
                        <SVGPath styleClass="icon"
                                 content="M3 13H21V11H3V13ZM3 18H21V16H3V18ZM3 6V8H21V6H3Z" />
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" text="Jobs" onAction="#onJobs">
                    <graphic>
                        <SVGPath styleClass="icon"
                                 content="M6 2H18C19.1 2 20 2.9 20 4V8H4V4C4 2.9 4.9 2 6 2ZM4 10H20V20C20 21.1 19.1 22 18 22H6C4.9 22 4 21.1 4 20V10ZM9 12H15V18H9V12Z" />
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" text="Manage Candidates" onAction="#onManageCandidates">
                    <graphic>
                        <SVGPath styleClass="icon"
                                 content="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" />
                    </graphic>
                </Button>
                
                <Button styleClass="sidebar-btn" text="Manage Domains" onAction="#onManageDomains">
                    <graphic>
                        <SVGPath styleClass="icon"
         content="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20ZM12 6C10.34 6 9 7.34 9 9C9 10.66 10.34 12 12 12C13.66 12 15 10.66 15 9C15 7.34 13.66 6 12 6ZM12 14C9.33 14 6 15.34 6 18V20H18V18C18 15.34 14.67 14 12 14Z" />

                    </graphic>
                </Button>

            </VBox>

            <!-- LOGO -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  prefHeight="115" prefWidth="132"
                  style="-fx-background-color: white; -fx-background-radius: 15;">
                <children>
                    <ImageView fx:id="logoImage" fitHeight="150" fitWidth="150" preserveRatio="true">
                        <image>
                            <Image url="@assetes/logo.png" />
                        </image>
                    </ImageView>
                </children>
            </HBox>

            <Button styleClass="logout-btn" text="Logout" onAction="#onLogout">
                <graphic>
                    <SVGPath styleClass="icon"
                             content="M16 17L21 12L16 7V10H8V14H16V17ZM4 4H14V2H4C2.9 2 2 2.9 2 4V20C2 21.1 2.9 22 4 22H14V20H4V4Z" />
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
    <VBox spacing="30" alignment="TOP_CENTER" style="-fx-padding: 20;">

        <!-- Title -->
        <Label text="Admin Dashboard Statistics" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <!-- Stat Cards -->
        <HBox spacing="20" alignment="CENTER">

            <!-- Companies Card -->
            <VBox spacing="5" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,4);" alignment="CENTER">
                <Label text="Companies" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="companiesCount" text="20" style="-fx-font-size: 32px; -fx-text-fill: #ff9800;"/>
                <Label text="+5 this week" style="-fx-font-size: 13px; -fx-text-fill: #757575;"/>
            </VBox>

            <!-- Candidates Card -->
            <VBox spacing="5" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,4);" alignment="CENTER">
                <Label text="Candidates" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="candidatesCount" text="12" style="-fx-font-size: 32px; -fx-text-fill: #4caf50;"/>
                <Label text="+2 new applications" style="-fx-font-size: 13px; -fx-text-fill: #757575;"/>
            </VBox>

            <!-- Recruiters Card -->
            <VBox spacing="5" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,4);" alignment="CENTER">
                <Label text="Recruiters" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="recruitersCount" text="22" style="-fx-font-size: 32px; -fx-text-fill: #2196f3;"/>
                <Label text="+1 this month" style="-fx-font-size: 13px; -fx-text-fill: #757575;"/>
            </VBox>

            <!-- Domains Card -->
            <VBox spacing="5" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,4);" alignment="CENTER">
                <Label text="Domains" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="domainsCount" text="19" style="-fx-font-size: 32px; -fx-text-fill: #9c27b0;"/>
                <Label text="+3 new sectors" style="-fx-font-size: 13px; -fx-text-fill: #757575;"/>
            </VBox>

            <!-- Job Offers Card -->
            <VBox spacing="5" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,4);" alignment="CENTER">
                <Label text="Job Offers" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="Joboffers" text="23" style="-fx-font-size: 32px; -fx-text-fill: #8B0000;"/>
                <Label text="+6 new jobs" style="-fx-font-size: 13px; -fx-text-fill: #757575;"/>
            </VBox>

        </HBox>

        <!-- Latest Activities Section -->
        <VBox spacing="15" alignment="TOP_LEFT" style="-fx-padding: 20; -fx-background-color: #ffffff; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,4);">
            <Label text="Latest Activities" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <VBox spacing="8">
                <Label text="• 5 new companies added" style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
                <Label text="• 12 new applications received" style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
                <Label text="• 3 job offers closed this week" style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
            </VBox>
        </VBox>

        <!-- Top Companies Section -->
        <VBox spacing="15" alignment="TOP_LEFT" style="-fx-padding: 20; -fx-background-color: #ffffff; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,4);">
            <Label text="Top Companies" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <VBox spacing="8">
                <Label text="1. ABC Corp - 12 active jobs" style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
                <Label text="2. XYZ Ltd - 10 active jobs" style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
                <Label text="3. Tech Solutions - 8 active jobs" style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
            </VBox>
        </VBox>

    </VBox>
</center>


</BorderPane>
