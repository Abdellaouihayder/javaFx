<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="750" prefWidth="1200" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP NAV BAR -->
    <top>
        <HBox spacing="15" styleClass="nav-bar">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>
            <HBox alignment="CENTER_RIGHT" spacing="25" HBox.hgrow="ALWAYS">
                <Label styleClass="nav-title" text="Job Portal Admin" />
                <Region HBox.hgrow="ALWAYS" />

                <!-- Dashboard Button -->
                <Button styleClass="nav-btn" text="Dashboard">
                    <graphic>
                        <SVGPath content="M3 13h4v-4H3v4zm6 6h4v-10h-4v10zm6-6h4v-4h-4v4z" styleClass="icon" />
                    </graphic>
                </Button>

                <!-- Notifications Button -->
                <Button styleClass="nav-btn" text="Notifications">
                    <graphic>
                        <SVGPath content="M12 2C10.3 2 9 3.3 9 5V6C6 6 4 8 4 11V16L2 18V19H22V18L20 16V11C20 8 18 6 15 6V5C15 3.3 13.7 2 12 2Z" styleClass="icon" />
                    </graphic>
                </Button>

                <!-- Profile Button -->
                <Button styleClass="nav-btn" text="Profile">
                    <graphic>
                        <SVGPath content="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" styleClass="icon" />
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="25" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="20" right="20" top="40" />
            </padding>

            <Label styleClass="sidebar-section-title" text="Welcome Admin" />

            <VBox spacing="10">
                <Button styleClass="sidebar-btn" text="Home">
                    <graphic>
                        <SVGPath content="M10 20V14H14V20H19V12H22L12 3 2 12H5V20H10Z" styleClass="icon" />
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" text="Manage Recruiter">
                    <graphic>
                        <SVGPath content="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" styleClass="icon" />
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" text="Manage Companies">
                    <graphic>
                        <SVGPath content="M3 13H21V11H3V13ZM3 18H21V16H3V18ZM3 6V8H21V6H3Z" styleClass="icon" />
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" text="Jobs">
                    <graphic>
                        <SVGPath content="M6 2H18C19.1 2 20 2.9 20 4V8H4V4C4 2.9 4.9 2 6 2ZM4 10H20V20C20 21.1 19.1 22 18 22H6C4.9 22 4 21.1 4 20V10ZM9 12H15V18H9V12Z" styleClass="icon" />
                    </graphic>
                </Button>


                <Button styleClass="sidebar-btn" text="Manage Candidates">
                    <graphic>
                        <SVGPath content="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" styleClass="icon" />
                    </graphic>
                </Button>
            </VBox>

            <!-- Sidebar Logo Image -->
            <!-- Sidebar Logo Image with rounded corners -->
            <HBox alignment="CENTER_LEFT" prefHeight="115.0" prefWidth="132.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15;" styleClass="logo-bg">
                <children>
                    <ImageView fx:id="logoImage" fitHeight="150.0" fitWidth="150.0" preserveRatio="true">
                        <image>
                            <Image url="@assetes/logo.png" />
                        </image>
                    </ImageView>
                </children>
            </HBox>


            <Button styleClass="logout-btn" text="Logout">
                <graphic>
                    <SVGPath content="M16 17L21 12L16 7V10H8V14H16V17ZM4 4H14V2H4C2.9 2 2 2.9 2 4V20C2 21.1 2.9 22 4 22H14V20H4V4Z" styleClass="icon" />
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane styleClass="main-content">
            <Label styleClass="main-label" text="Welcome to your Admin Dashboard!" />
        </StackPane>
    </center>

</BorderPane>
