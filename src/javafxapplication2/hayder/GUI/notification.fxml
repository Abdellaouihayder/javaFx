<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="15"
      alignment="TOP_CENTER"
      style="-fx-background-color: #ecf0f1; -fx-padding: 20; -fx-background-radius: 10;"
      prefWidth="400" prefHeight="600"
    fx:controller="javafxapplication2.hayderController.NotificationController"
>
    <Label text="Notifications" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2b3a67;" />

    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 10;">
        
        <!-- Notification 1 -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8; -fx-background-radius: 6;">
            <SVGPath content="M12 2C10.3 2 9 3.3 9 5V6C6 6 4 8 4 11V16L2 18V19H22V18L20 16V11C20 8 18 6 15 6V5C15 3.3 13.7 2 12 2Z"
                     style="-fx-fill: #2b3a67; -fx-scale-x: 1.2; -fx-scale-y: 1.2;" />
            <Label text="New job posted: Senior Backend Developer" />
        </HBox>

        <!-- Notification 2 -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8; -fx-background-radius: 6;">
            <SVGPath content="M16 17L21 12L16 7V10H8V14H16V17ZM4 4H14V2H4C2.9 2 2 2.9 2 4V20C2 21.1 2.9 22 4 22H14V20H4V4Z"
                     style="-fx-fill: #e67e22; -fx-scale-x: 1.2; -fx-scale-y: 1.2;" />
            <Label text="Candidate John Doe applied for Frontend Developer" />
        </HBox>

        <!-- Notification 3 -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8; -fx-background-radius: 6;">
            <SVGPath content="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12Z"
                     style="-fx-fill: #27ae60; -fx-scale-x: 1.2; -fx-scale-y: 1.2;" />
            <Label text="Profile updated: Company ACME Inc." />
        </HBox>

        <!-- Notification 4 -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8; -fx-background-radius: 6;">
            <SVGPath content="M12 2C10.3 2 9 3.3 9 5V6C6 6 4 8 4 11V16L2 18V19H22V18L20 16V11C20 8 18 6 15 6V5C15 3.3 13.7 2 12 2Z"
                     style="-fx-fill: #2980b9; -fx-scale-x: 1.2; -fx-scale-y: 1.2;" />
            <Label text="Interview reminder: Candidate Jane Smith at 10:00 AM" />
        </HBox>

        <!-- Extra Fake Notifications -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8; -fx-background-radius: 6;">
            <SVGPath content="M12 2C10.3 2 9 3.3 9 5V6C6 6 4 8 4 11V16L2 18V19H22V18L20 16V11C20 8 18 6 15 6V5C15 3.3 13.7 2 12 2Z"
                     style="-fx-fill: #8e44ad; -fx-scale-x: 1.2; -fx-scale-y: 1.2;" />
            <Label text="New message: Recruiter invited you to a meeting" />
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8; -fx-background-radius: 6;">
            <SVGPath content="M12 2C10.3 2 9 3.3 9 5V6C6 6 4 8 4 11V16L2 18V19H22V18L20 16V11C20 8 18 6 15 6V5C15 3.3 13.7 2 12 2Z"
                     style="-fx-fill: #c0392b; -fx-scale-x: 1.2; -fx-scale-y: 1.2;" />
            <Label text="Warning: Your profile is missing some information" />
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8; -fx-background-radius: 6;">
            <SVGPath content="M12 2C10.3 2 9 3.3 9 5V6C6 6 4 8 4 11V16L2 18V19H22V18L20 16V11C20 8 18 6 15 6V5C15 3.3 13.7 2 12 2Z"
                     style="-fx-fill: #16a085; -fx-scale-x: 1.2; -fx-scale-y: 1.2;" />
            <Label text="System update: Version 2.3 installed successfully" />
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8; -fx-background-radius: 6;">
            <SVGPath content="M12 2C10.3 2 9 3.3 9 5V6C6 6 4 8 4 11V16L2 18V19H22V18L20 16V11C20 8 18 6 15 6V5C15 3.3 13.7 2 12 2Z"
                     style="-fx-fill: #f39c12; -fx-scale-x: 1.2; -fx-scale-y: 1.2;" />
            <Label text="You have 3 new job recommendations" />
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8; -fx-background-radius: 6;">
            <SVGPath content="M12 2C10.3 2 9 3.3 9 5V6C6 6 4 8 4 11V16L2 18V19H22V18L20 16V11C20 8 18 6 15 6V5C15 3.3 13.7 2 12 2Z"
                     style="-fx-fill: #2c3e50; -fx-scale-x: 1.2; -fx-scale-y: 1.2;" />
            <Label text="New connection: Alice joined your network" />
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8; -fx-background-radius: 6;">
            <SVGPath content="M12 2C10.3 2 9 3.3 9 5V6C6 6 4 8 4 11V16L2 18V19H22V18L20 16V11C20 8 18 6 15 6V5C15 3.3 13.7 2 12 2Z"
                     style="-fx-fill: #34495e; -fx-scale-x: 1.2; -fx-scale-y: 1.2;" />
            <Label text="Reminder: Submit your project by tomorrow" />
        </HBox>
    </VBox>

    <!-- Bouton Retour -->
    <Button fx:id="btnRetour"
            text="⟵ Retour"
            styleClass="btn-retour"
            alignment="CENTER_LEFT"
            onAction="#handleRetour"
            style=" -fx-background-color: #2b3a67;
    -fx-text-fill: white;
    -fx-padding: 6 14;
    -fx-background-radius: 6;
    -fx-font-size: 14px;
    -fx-cursor: hand;"
            />
    
</VBox>
