<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="900"
    style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f4f7fb);"
    stylesheets="@home.css"
    xmlns:fx="http://javafx.com/fxml/1"
    xmlns="http://javafx.com/javafx/24.0.1"
    fx:controller="javafxapplication2.hayderController.HomeController">

    <children>
        <VBox alignment="CENTER" prefHeight="600" prefWidth="900" spacing="30">
            <padding>
                <Insets bottom="40" left="40" right="40" top="40" />
            </padding>

            <!-- Logo and Title -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>

                <ImageView fx:id="logoImage" fitHeight="80" fitWidth="80" pickOnBounds="true"
                    preserveRatio="true"
                    style="-fx-background-radius: 60; -fx-border-radius: 60; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10,0,0,2);">
                    <image>
                        <Image url="@assetes/logo.png" />
                    </image>
                </ImageView>

                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2b3a67;"
                    text="Agence de Recrutement et Gestion d'Appels d’Offres" />
            </HBox>

            <Separator prefWidth="700" />

            <!-- Description -->
            <Label alignment="CENTER" prefWidth="700"
                style="-fx-font-size: 16px; -fx-text-fill: #444;"
                text="Bienvenue dans notre plateforme de recrutement et de gestion d’appels d’offres. Cette application vous permet de connecter les candidats, les entreprises,  et de gérer facilement les opportunités et les offres en un seul endroit."
                wrapText="true" />

            <!-- Buttons with icons -->
            <HBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <!-- Se Connecter -->
                <Button fx:id="btnLogin" styleClass="primary-btn" text="Se Connecter" onAction="#handleLogin" />

                <!-- Créer un Compte -->
                <Button fx:id="btnRegister" styleClass="secondary-btn" text="Créer un Compte" onAction="#handleRegister" />

                <!-- À propos -->
                <Button fx:id="btnAbout" styleClass="outline-btn" text="À propos" onAction="#handleAbout" />
            </HBox>

            <!-- Footer -->
            <Label style="-fx-font-size: 12px; -fx-text-fill: #777;"
                text="© 2025 Agence Recrutement - Tous droits réservés" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #777;"
                text="Created by Hayder Abdellaoui" />
        </VBox>
    </children>
</AnchorPane>
